    colbar2.FontSize = 10;
    colbar2.Label.String = '[mm]';
    
%     [xsph,ysph,zsph] = sphere(30);
%     xsph = Radius_h2f(a)*xsph+Centers_h2f(a,1);
%     ysph = Radius_h2f(a)*ysph+Centers_h2f(a,2);
