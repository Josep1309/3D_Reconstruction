function [coef,e,F0]=Racionalfit3D(X,Y,cc,degree)

switch(degree)
    case 1
        [coef,e,F0]=Racionalfit1_3D(X,Y,cc);
    case 2
        [coef,e,F0]=Racionalfit2_3D(X,Y,cc);

    otherwise
        disp("Polinomio no implementado")
end


end



function [coef,e,F1] = Racionalfit1_3D(Xi,Y,cc)

% Xn = X;
% Xn(~isnan(X)) = 0;
% X(isnan(X)) = 1;

mX = mean(Xi,3,'omitnan');
sX = std(Xi,[],3,'omitnan');
X = (Xi - mX)./sX;



tic
X2 = X.*X; Y2 = Y.*Y;
F1  = sum(~isnan(X),3);         Z1 = sum(Y+(X*0),3,'omitnan'); disp('..')
F2  = sum(X,3,'omitnan');       Z2 = sum(Y.*X,3,'omitnan'); disp('..')
F3  = sum(-X.*Y,3,'omitnan');   Z3 = sum(-X.*Y2,3,'omitnan'); disp('..')
F4  = 0;  Z4 = 0; disp('..')
F5  = sum(X2,3,'omitnan'); 
F6  = sum(-X2.*Y,3,'omitnan'); disp('..')
F7  = 0; disp('..')
F8  = sum(X2.*Y2,3,'omitnan'); disp('..')
F9  = 0; disp('..')
F10 = 1; disp('..')
toc


dete =F3.*F3.*F7.*F7 + F4.*F4.*F6.*F6 + F2.*F2.*F9.*F9 - F1.*F5.*F9.*F9 - F1.*F7.*F7.*F8 - F1.*F6.*F6.*F10 - F4.*F4.*F5.*F8 - F3.*F3.*F5.*F10 - F2.*F2.*F8.*F10 - 2.*F3.*F4.*F6.*F7 + 2.*F2.*F3.*F6.*F10 - 2.*F2.*F3.*F7.*F9 - 2.*F2.*F4.*F6.*F9 + 2.*F2.*F4.*F7.*F8 + 2.*F3.*F4.*F5.*F9 + 2.*F1.*F6.*F7.*F9 + F1.*F5.*F8.*F10;
a = (F2.*F9.*F9.*Z2 + F3.*F7.*F7.*Z3 + F4.*F6.*F6.*Z4 - F5.*F9.*F9.*Z1 - F7.*F7.*F8.*Z1 - F6.*F6.*F10.*Z1 - F3.*F6.*F7.*Z4 - F4.*F6.*F7.*Z3 - F2.*F6.*F9.*Z4 + F2.*F6.*F10.*Z3 + F2.*F7.*F8.*Z4 - F2.*F7.*F9.*Z3 + F3.*F5.*F9.*Z4 - F3.*F5.*F10.*Z3 + F3.*F6.*F10.*Z2 - F3.*F7.*F9.*Z2 - F4.*F5.*F8.*Z4 + F4.*F5.*F9.*Z3 - F4.*F6.*F9.*Z2 + F4.*F7.*F8.*Z2 - F2.*F8.*F10.*Z2 + 2.*F6.*F7.*F9.*Z1 + F5.*F8.*F10.*Z1)./dete;
b = (F2.*F9.*F9.*Z1 - F1.*F9.*F9.*Z2 + F4.*F4.*F6.*Z3 + F3.*F3.*F7.*Z4 - F4.*F4.*F8.*Z2 - F3.*F3.*F10.*Z2 - F3.*F4.*F6.*Z4 - F3.*F4.*F7.*Z3 - F2.*F3.*F9.*Z4 + F2.*F3.*F10.*Z3 + F2.*F4.*F8.*Z4 - F2.*F4.*F9.*Z3 + 2.*F3.*F4.*F9.*Z2 + F1.*F6.*F9.*Z4 - F1.*F6.*F10.*Z3 - F1.*F7.*F8.*Z4 + F1.*F7.*F9.*Z3 + F3.*F6.*F10.*Z1 - F3.*F7.*F9.*Z1 - F4.*F6.*F9.*Z1 + F4.*F7.*F8.*Z1 + F1.*F8.*F10.*Z2 - F2.*F8.*F10.*Z1)./dete;
c = (F3.*F7.*F7.*Z1 - F1.*F7.*F7.*Z3 - F4.*F4.*F5.*Z3 + F4.*F4.*F6.*Z2 + F2.*F2.*F9.*Z4 - F2.*F2.*F10.*Z3 - F2.*F3.*F7.*Z4 - F2.*F4.*F6.*Z4 + 2.*F2.*F4.*F7.*Z3 + F3.*F4.*F5.*Z4 - F3.*F4.*F7.*Z2 + F2.*F3.*F10.*Z2 - F2.*F4.*F9.*Z2 + F1.*F6.*F7.*Z4 - F4.*F6.*F7.*Z1 - F1.*F5.*F9.*Z4 + F1.*F5.*F10.*Z3 - F1.*F6.*F10.*Z2 + F1.*F7.*F9.*Z2 + F2.*F6.*F10.*Z1 - F2.*F7.*F9.*Z1 - F3.*F5.*F10.*Z1 + F4.*F5.*F9.*Z1)./dete;
d = (F4.*F6.*F6.*Z1 - F1.*F6.*F6.*Z4 - F3.*F3.*F5.*Z4 + F3.*F3.*F7.*Z2 - F2.*F2.*F8.*Z4 + F2.*F2.*F9.*Z3 + 2.*F2.*F3.*F6.*Z4 - F2.*F3.*F7.*Z3 - F2.*F4.*F6.*Z3 + F3.*F4.*F5.*Z3 - F3.*F4.*F6.*Z2 - F2.*F3.*F9.*Z2 + F2.*F4.*F8.*Z2 + F1.*F6.*F7.*Z3 - F3.*F6.*F7.*Z1 + F1.*F5.*F8.*Z4 - F1.*F5.*F9.*Z3 + F1.*F6.*F9.*Z2 - F1.*F7.*F8.*Z2 - F2.*F6.*F9.*Z1 + F2.*F7.*F8.*Z1 + F3.*F5.*F9.*Z1 - F4.*F5.*F8.*Z1)./dete;

% d=0;
a = (a-b.*mX./sX)./(1+d.*(mX.*mX./(sX.*sX))-mX.*c./sX);
b =      (b./sX)./(1+d.*(mX.*mX./(sX.*sX))-mX.*c./sX);
c1 = (c./sX - 2*mX.*d./(sX.*sX))./(1+d.*(mX.*mX./(sX.*sX))-mX.*c./sX);
% d = (d./(sX.*sX))./(1+d.*(mX.*mX./(sX.*sX))-mX.*c./sX);
c =c1;
% d = 0*a;

coef = cat(3,a,b,c,d);
X = Xi;

if(~isempty(cc))
cx = cc(1); cy = cc(2);
x = shiftdim(X(cx,cy,:));
y = shiftdim(Y(cx,cy,:));
figure, plot(x,y,'*')
x = sort(x);

fy = (a(cx,cy) + b(cx,cy)*x)./(1+c(cx,cy)*x+d(cx,cy).*x.*x); 

hold on, plot(x,fy);
end

 XX = (a + b.*Xi)./(1+c.*Xi+d.*Xi.*Xi);

ex = Y-XX;
e = sqrt(sum((ex).^2,3,'omitnan')./F1);


end

function [coef,e,F1]  = Racionalfit2_3D(Xi,Y,cc)

% Xn = X;
% Xn(~isnan(X)) = 0;
% X(isnan(X)) = 1;

mX = mean(Xi,3,'omitnan');
sX = std(Xi,[],3,'omitnan');
X = (Xi - mX)./sX;



tic
X2 = X.*X; Y2 = Y.*Y;
F1  = sum(~isnan(X),3);             
IndV = NaN.*F1; IndV(F1>5)=1;

Z1 = sum(Y+(X*0),3,'omitnan'); disp('..')
F2  = sum(X,3,'omitnan');           Z2 = sum(Y.*X,3,'omitnan'); disp('..')
F3  = sum(X2,3,'omitnan');          Z3 = sum(Y.*X2,3,'omitnan'); disp('..')
F4  = sum(-X.*Y,3,'omitnan');       Z4 = sum(-X.*Y2,3,'omitnan'); disp('..')
F5  = sum(-X2.*Y,3,'omitnan');      Z5 = sum(-X2.*Y2,3,'omitnan'); disp('..')
F6  = sum(Y2,3,'omitnan'); disp('..')
F7  = sum(Y.*Y2,3,'omitnan'); disp('..')
F8  = sum(-X2.*Y,3,'omitnan'); disp('..')
F9  = sum(-X2.*X.*Y,3,'omitnan'); disp('..')
F10 = sum(X2.*X2,3,'omitnan'); disp('..')
F11 = sum(-X2.*X.*Y,3,'omitnan'); disp('..')
F12 = sum(-X2.*X2.*Y,3,'omitnan'); disp('..')
F13 = sum(X2.*Y2,3,'omitnan'); disp('..')
F14 = sum(X2.*X.*Y2,3,'omitnan'); disp('..')
F15 = sum(X2.*X2.*Y2,3,'omitnan'); disp('..')
toc


dete = F1.*F8.*F8.*F12.*F12 + F1.*F9.*F9.*F11.*F11 + F1.*F7.*F7.*F14.*F14 + F4.*F4.*F6.*F12.*F12 + F5.*F5.*F6.*F11.*F11 + F3.*F3.*F6.*F14.*F14 + F4.*F4.*F9.*F9.*F10 + F5.*F5.*F8.*F8.*F10 + F3.*F3.*F9.*F9.*F13 + F5.*F5.*F7.*F7.*F13 + F2.*F2.*F10.*F14.*F14 + F3.*F3.*F8.*F8.*F15 + F4.*F4.*F7.*F7.*F15 + F2.*F2.*F12.*F12.*F13 + F2.*F2.*F11.*F11.*F15 - 2.*F2.*F3.*F7.*F14.*F14 - 2.*F2.*F4.*F8.*F12.*F12 - 2.*F2.*F5.*F9.*F11.*F11 - 2.*F3.*F4.*F9.*F9.*F11 - 2.*F3.*F5.*F8.*F8.*F12 - 2.*F4.*F5.*F7.*F7.*F14 - F1.*F6.*F10.*F14.*F14 - 2.*F5.*F5.*F7.*F8.*F11 - F1.*F6.*F12.*F12.*F13 - 2.*F4.*F4.*F7.*F9.*F12 - F1.*F6.*F11.*F11.*F15 - F1.*F9.*F9.*F10.*F13 - F1.*F8.*F8.*F10.*F15 - 2.*F3.*F3.*F8.*F9.*F14 - F5.*F5.*F6.*F10.*F13 - F4.*F4.*F6.*F10.*F15 - F1.*F7.*F7.*F13.*F15 - F3.*F3.*F6.*F13.*F15 - 2.*F2.*F2.*F11.*F12.*F14 - F2.*F2.*F10.*F13.*F15 + 2.*F3.*F4.*F8.*F9.*F12 + 2.*F3.*F5.*F8.*F9.*F11 + 2.*F4.*F5.*F7.*F8.*F12 + 2.*F4.*F5.*F7.*F9.*F11 - 2.*F4.*F5.*F8.*F9.*F10 - 2.*F3.*F4.*F7.*F8.*F15 + 2.*F3.*F4.*F7.*F9.*F14 + 2.*F3.*F5.*F7.*F8.*F14 - 2.*F3.*F5.*F7.*F9.*F13 + 2.*F2.*F4.*F9.*F11.*F12 + 2.*F2.*F5.*F8.*F11.*F12 - 2.*F4.*F5.*F6.*F11.*F12 - 2.*F2.*F3.*F8.*F11.*F15 + 2.*F2.*F3.*F8.*F12.*F14 + 2.*F2.*F3.*F9.*F11.*F14 - 2.*F2.*F3.*F9.*F12.*F13 - 2.*F2.*F4.*F7.*F11.*F15 + 2.*F2.*F4.*F7.*F12.*F14 + 2.*F2.*F4.*F8.*F10.*F15 - 2.*F2.*F4.*F9.*F10.*F14 + 2.*F2.*F5.*F7.*F11.*F14 - 2.*F2.*F5.*F7.*F12.*F13 - 2.*F2.*F5.*F8.*F10.*F14 + 2.*F2.*F5.*F9.*F10.*F13 + 2.*F3.*F4.*F6.*F11.*F15 - 2.*F3.*F4.*F6.*F12.*F14 - 2.*F3.*F5.*F6.*F11.*F14 + 2.*F3.*F5.*F6.*F12.*F13 + 2.*F4.*F5.*F6.*F10.*F14 + 2.*F2.*F3.*F7.*F13.*F15 - 2.*F1.*F8.*F9.*F11.*F12 + 2.*F1.*F7.*F8.*F11.*F15 - 2.*F1.*F7.*F8.*F12.*F14 - 2.*F1.*F7.*F9.*F11.*F14 + 2.*F1.*F7.*F9.*F12.*F13 + 2.*F1.*F8.*F9.*F10.*F14 + 2.*F1.*F6.*F11.*F12.*F14 + F1.*F6.*F10.*F13.*F15;
a = (F8.*F8.*F12.*F12.*Z1 + F9.*F9.*F11.*F11.*Z1 + F7.*F7.*F14.*F14.*Z1 - F2.*F7.*F14.*F14.*Z3 - F2.*F8.*F12.*F12.*Z4 + F3.*F6.*F14.*F14.*Z3 - F3.*F7.*F14.*F14.*Z2 + F4.*F6.*F12.*F12.*Z4 - F4.*F8.*F12.*F12.*Z2 - F2.*F9.*F11.*F11.*Z5 - F3.*F9.*F9.*F11.*Z4 + F4.*F9.*F9.*F10.*Z4 - F4.*F9.*F9.*F11.*Z3 + F5.*F6.*F11.*F11.*Z5 - F5.*F9.*F11.*F11.*Z2 + F2.*F10.*F14.*F14.*Z2 - F3.*F8.*F8.*F12.*Z5 + F3.*F9.*F9.*F13.*Z3 + F5.*F8.*F8.*F10.*Z5 - F5.*F8.*F8.*F12.*Z3 + F2.*F12.*F12.*F13.*Z2 + F3.*F8.*F8.*F15.*Z3 + F2.*F11.*F11.*F15.*Z2 - F4.*F7.*F7.*F14.*Z5 + F4.*F7.*F7.*F15.*Z4 + F5.*F7.*F7.*F13.*Z5 - F5.*F7.*F7.*F14.*Z4 - F6.*F10.*F14.*F14.*Z1 - F6.*F12.*F12.*F13.*Z1 - F6.*F11.*F11.*F15.*Z1 - F9.*F9.*F10.*F13.*Z1 - F8.*F8.*F10.*F15.*Z1 - F7.*F7.*F13.*F15.*Z1 + F3.*F8.*F9.*F11.*Z5 + F3.*F8.*F9.*F12.*Z4 + F4.*F7.*F8.*F12.*Z5 + F4.*F7.*F9.*F11.*Z5 - 2.*F4.*F7.*F9.*F12.*Z4 - F4.*F8.*F9.*F10.*Z5 + F4.*F8.*F9.*F12.*Z3 - 2.*F5.*F7.*F8.*F11.*Z5 + F5.*F7.*F8.*F12.*Z4 + F5.*F7.*F9.*F11.*Z4 - F5.*F8.*F9.*F10.*Z4 + F5.*F8.*F9.*F11.*Z3 + F3.*F7.*F8.*F14.*Z5 - F3.*F7.*F8.*F15.*Z4 - F3.*F7.*F9.*F13.*Z5 + F3.*F7.*F9.*F14.*Z4 - 2.*F3.*F8.*F9.*F14.*Z3 - F4.*F7.*F8.*F15.*Z3 + F4.*F7.*F9.*F14.*Z3 + F5.*F7.*F8.*F14.*Z3 - F5.*F7.*F9.*F13.*Z3 + F2.*F8.*F11.*F12.*Z5 + F2.*F9.*F11.*F12.*Z4 - F4.*F6.*F11.*F12.*Z5 + F4.*F9.*F11.*F12.*Z2 - F5.*F6.*F11.*F12.*Z4 + F5.*F8.*F11.*F12.*Z2 + F2.*F7.*F11.*F14.*Z5 - F2.*F7.*F11.*F15.*Z4 - F2.*F7.*F12.*F13.*Z5 + F2.*F7.*F12.*F14.*Z4 - F2.*F8.*F10.*F14.*Z5 + F2.*F8.*F10.*F15.*Z4 - F2.*F8.*F11.*F15.*Z3 + F2.*F8.*F12.*F14.*Z3 + F2.*F9.*F10.*F13.*Z5 - F2.*F9.*F10.*F14.*Z4 + F2.*F9.*F11.*F14.*Z3 - F2.*F9.*F12.*F13.*Z3 - F3.*F6.*F11.*F14.*Z5 + F3.*F6.*F11.*F15.*Z4 + F3.*F6.*F12.*F13.*Z5 - F3.*F6.*F12.*F14.*Z4 - F3.*F8.*F11.*F15.*Z2 + F3.*F8.*F12.*F14.*Z2 + F3.*F9.*F11.*F14.*Z2 - F3.*F9.*F12.*F13.*Z2 + F4.*F6.*F10.*F14.*Z5 - F4.*F6.*F10.*F15.*Z4 + F4.*F6.*F11.*F15.*Z3 - F4.*F6.*F12.*F14.*Z3 - F4.*F7.*F11.*F15.*Z2 + F4.*F7.*F12.*F14.*Z2 + F4.*F8.*F10.*F15.*Z2 - F4.*F9.*F10.*F14.*Z2 - F5.*F6.*F10.*F13.*Z5 + F5.*F6.*F10.*F14.*Z4 - F5.*F6.*F11.*F14.*Z3 + F5.*F6.*F12.*F13.*Z3 + F5.*F7.*F11.*F14.*Z2 - F5.*F7.*F12.*F13.*Z2 - F5.*F8.*F10.*F14.*Z2 + F5.*F9.*F10.*F13.*Z2 + F2.*F7.*F13.*F15.*Z3 - F3.*F6.*F13.*F15.*Z3 + F3.*F7.*F13.*F15.*Z2 - 2.*F2.*F11.*F12.*F14.*Z2 - 2.*F8.*F9.*F11.*F12.*Z1 - F2.*F10.*F13.*F15.*Z2 + 2.*F7.*F8.*F11.*F15.*Z1 - 2.*F7.*F8.*F12.*F14.*Z1 - 2.*F7.*F9.*F11.*F14.*Z1 + 2.*F7.*F9.*F12.*F13.*Z1 + 2.*F8.*F9.*F10.*F14.*Z1 + 2.*F6.*F11.*F12.*F14.*Z1 + F6.*F10.*F13.*F15.*Z1)./dete;
