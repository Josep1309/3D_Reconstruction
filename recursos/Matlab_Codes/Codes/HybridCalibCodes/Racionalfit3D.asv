% a2 = (c.*mX.*mX - b.*mX.*sX + a.*sX.*sX)./cons;
% b2 = (b.*sX - 2.*c.*mX)./cons;
% c2 = c./cons;
% d2 = (d.*sX - 2.*e.*mX)./cons;
% e2 = e./cons;



coef = cat(3,a,b,c,d,e,f,g);
X = Xi;


if(~isempty(cc))
    cx = cc(1); cy = cc(2);
    x = shiftdim(X(cx,cy,:));
    y = shiftdim(Y(cx,cy,:));
    figure, plot(x,y,'*')
    x = sort(x);

    fy = (a2(cx,cy) + b2(cx,cy)*x + c2(cx,cy).*x.*x)./(1+d2(cx,cy)*x+e2(cx,cy).*x.*x);

    hold on, plot(x,fy);
end


 ZZ = (a + b.* +c2.*Xi.*Xi)./(1+d2.*Xi+e2.*Xi.*Xi);

ex = Y-XX;
e = sqrt(sum((ex).^2,3,'omitnan')./F1);


end
