b2 = (b.*sX - 2.*c.*mX)./cons;
c2 = c./cons;
d2 = (d.*sX - 2.*e.*mX)./cons;
e2 = e./cons;



coef = cat(3,a2,b2,d2,e2,c2);
X = Xi;

if(~isempty(cc))
    cx = cc(1); cy = cc(2);
    x = shiftdim(X(cx,cy,:));
    y = shiftdim(Y(cx,cy,:));
    figure, plot(x,y,'*')
    x = sort(x);

    fy = (a2(cx,cy) + b2(cx,cy)*x + c2(cx,cy).*x.*x)./(1+d2(cx,cy)*x+e2(cx,cy).*x.*x);

    hold on, plot(x,fy);
end

 XX = (a2 + b2.*Xi +c2.*Xi.*Xi)./(1+d2.*Xi+e2.*Xi.*Xi);

ex = Y-XX;
e = sqrt(sum((ex).^2,3,'omitnan')./F1);


end


function [coef,e,F1]  = RacionalfitXY_3D(Fx,Fy,Z,cc)

% Xn = X;
% Xn(~isnan(X)) = 0;
% X(isnan(X)) = 1;

% mX = mean(Xi,3,'omitnan');
% sX = std(Xi,[],3,'omitnan');
