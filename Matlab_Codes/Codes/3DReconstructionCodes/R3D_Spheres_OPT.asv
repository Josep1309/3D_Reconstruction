    gg.Parent.Color = 'none';
    gg.Parent.FontSize = 11;
    axis equal,    
    ylim([1 1600]),xlim([1 1200])

%     ylim([st(1) st(1)+st(3)]), xlim([st(2) st(2)+st(4)]), %colorbar

    ylabel('$u_c$ [px]','Interpreter','latex')
    xlabel('$v_c$ [px]','Interpreter','latex')
    gg.Parent.Title.String = {'Error map';names{3}};
    colormap(colMesh)
    %     colorbar
    caxis([-rang rang+0.002])
    gg.Parent.FontSize = 15;
    gg.Parent.FontWeight = 'bold';


    subplot(2,3,5),
    gg = imagesc(errormaps{4}(:,:,a)');
    gg.Parent.Color = 'none';
    gg.Parent.FontSize = 11;
    axis equal,    
    ylim([1 1600]),xlim([1 1200])

%     ylim([st(1) st(1)+st(3)]), xlim([st(2) st(2)+st(4)]), %colorbar

    ylabel('$u_c$ [px]','Interpreter','latex')
    xlabel('$v_c$ [px]','Interpreter','latex')
    gg.Parent.Title.String = {'Error map';names{4}};
    colormap(colMesh)
    %     colorbar
    caxis([-rang rang+0.002])
    gg.Parent.FontSize = 15;
    gg.Parent.FontWeight = 'bold';






    subplot(2,3,3),
    hold off

    g2 = histogram(errormaps{1}(:,:,a)   ,(-rang:0.01:rang),'DisplayName', ...
        [names{1}, '. Rmse :', sprintf('%3.3f',RMSes{1}(a))]); hold on
    g3 = histogram(errormaps{2}(:,:,a)  ,(-rang:0.01:rang),'DisplayName', ...
        [names{2}, '. Rmse :', sprintf('%3.3f',RMSes{2}(a))]);
    g4 = histogram(errormaps{3}(:,:,a) ,(-rang:0.01:rang),'DisplayName', ...
        [names{3}, '. Rmse :', sprintf('%3.3f',RMSes{3}(a))]);
    g5 = histogram(errormaps{4}(:,:,a) ,(-rang:0.01:rang),'DisplayName', ...
        [names{4}, '. Rmse :', sprintf('%3.3f',RMSes{4}(a))]);

   

    grid on

    g2.FaceColor = [0.8 0 0];
    g2.EdgeColor = 'none';
    g2.FaceAlpha =0.6;
    g2.LineStyle = 'none';
    g2.Orientation = 'vertical';


    g3.FaceColor = [0 0.8 0];
    g3.EdgeColor = 'none';
    g3.FaceAlpha =0.6;
    g3.LineStyle = 'none';
    g3.Orientation = 'vertical';

    g4.FaceColor = [0 0 0.6];
    g4.EdgeColor = 'none';
    g4.FaceAlpha =0.6;
    g4.LineStyle = 'none';
    g4.Orientation = 'vertical';

    g5.FaceColor = [0.8 0 0.8];
    g5.EdgeColor = 'none';
    g5.FaceAlpha =0.6;
    g5.LineStyle = 'none';
    g5.Orientation = 'vertical';


    g2.Parent.YLim = [0 10*10^4];
    g2.Parent.XLim = [-rang rang*1.005];
    g2.Parent.XLabel.String = 'Error [mm]';
    g2.Parent.YLabel.String = 'Points';
    g2.Parent.FontSize = 16;
    g2.Parent.XLabel.FontSize = 16;
    g2.Parent.Title.String = 'Error Histograms';
    g2.Parent.Title.Position(2) = g2.Parent.Title.Position(2)*1.05;

    %     g.XAxis
    leg = legend('FontSize',9,'Location','best');
    leg.Orientation = 'vertical';
    leg.FontSize = 12;


    colormap(turbo(256))
    colb = colorbar();
    colb.Position = [0.0600    0.4000    0.0164    0.3226];
    colb.Ticks = linspace(0,1,5);
    colb.TickLabels = {num2str(linspace(-rang,rang,5)')};



%     ffcb = subplot(2,3,5);
%     hold off
% 
% 
%     x1 = e_h1(:,:,a).*IndX(:,:,a)+Radius_h1(a);
%     x1 = x1(~isnan(x1));
% 
%     x2 = e_s(:,:,a).*IndX(:,:,a)+Radius_s(a);
